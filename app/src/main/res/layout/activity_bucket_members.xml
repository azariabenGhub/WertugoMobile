<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".BucketMembersActivity">

    <RelativeLayout
        android:id="@+id/layout_members_header"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_members_room_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="Bucket List 1"
            android:textColor="@color/black"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-black" />

        <ImageView
            android:id="@+id/btn_members_options"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@android:drawable/ic_menu_more"
            app:tint="@color/black"
            android:clickable="true"
            android:focusable="true"
            tools:ignore="ContentDescription" />
    </RelativeLayout>

    <TextView
        android:id="@+id/tv_label_anggota"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="8dp"
        android:text="Anggota"
        android:textColor="@color/black"
        android:textStyle="bold"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/layout_members_header"
        app:layout_constraintStart_toStartOf="parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bucket_members"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:paddingHorizontal="24dp"
        android:paddingBottom="80dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        android:orientation="vertical"
        tools:itemCount="3"
        tools:listitem="@layout/item_bucket_member"
        app:layout_constraintTop_toBottomOf="@id/tv_label_anggota"
        app:layout_constraintBottom_toTopOf="@id/layout_user_navbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fab_add_member_trigger"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#52D681"
        app:cardElevation="4dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/layout_user_navbar"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_input_add"
            android:layout_gravity="center"
            app:tint="@color/black"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/layout_user_navbar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#008B09"
        android:orientation="horizontal"
        android:weightSum="4"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_home" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_search" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:background="@drawable/bg_nav_active" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_message" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center">
            <ImageView android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_profile" app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/view_dim_overlay_members"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>