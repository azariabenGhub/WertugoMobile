<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".activities.RegisterLegalitasActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="40dp">

            <!-- Header -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wertugo"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="32dp"
                android:text="Lengkapi Dokumen Legalitas"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium" />

            <!-- ==================== NIB ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nomor Induk Berusaha (NIB)"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_nib"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="end"
                app:strokeColor="@color/wtg_primary_green"
                app:strokeWidth="1dp"
                android:text="Upload File (JPG/PNG/PDF)"
                android:textColor="@color/wtg_primary_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_nib_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Belum ada file dipilih"
                android:textColor="#666666"
                android:textSize="11sp" />

            <!-- ==================== NPWP ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nomor Pokok Wajib Pajak (NPWP)"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_npwp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="end"
                app:strokeColor="@color/wtg_primary_green"
                app:strokeWidth="1dp"
                android:text="Upload File (JPG/PNG/PDF)"
                android:textColor="@color/wtg_primary_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_npwp_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Belum ada file dipilih"
                android:textColor="#666666"
                android:textSize="11sp" />

            <!-- ==================== LEGALITAS BANGUNAN ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dokumen Legalitas Bangunan"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_bangunan"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="end"
                app:strokeColor="@color/wtg_primary_green"
                app:strokeWidth="1dp"
                android:text="Upload File (JPG/PNG/PDF)"
                android:textColor="@color/wtg_primary_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_bangunan_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Belum ada file dipilih (Opsional)"
                android:textColor="#666666"
                android:textSize="11sp" />

            <!-- ==================== SERTIFIKAT HALAL ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sertifikat Halal"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_halal"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="end"
                app:strokeColor="@color/wtg_primary_green"
                app:strokeWidth="1dp"
                android:text="Upload File (JPG/PNG/PDF)"
                android:textColor="@color/wtg_primary_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_halal_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="16dp"
                android:text="Belum ada file dipilih (Opsional)"
                android:textColor="#666666"
                android:textSize="11sp" />

            <!-- ==================== SERTIFIKAT USAHA PARIWISATA ==================== -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Sertifikat Usaha Pariwisata"
                android:textColor="@color/black"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_upload_pariwisata"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_upload"
                app:iconGravity="end"
                app:strokeColor="@color/wtg_primary_green"
                app:strokeWidth="1dp"
                android:text="Upload File (JPG/PNG/PDF)"
                android:textColor="@color/wtg_primary_green"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_pariwisata_filename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="Belum ada file dipilih (Opsional)"
                android:textColor="#666666"
                android:textSize="11sp" />

            <!-- Tombol Lanjutkan -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_submit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="16dp"
                android:text="Kirim Dokumen"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/wtg_primary_green"
                app:cornerRadius="28dp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>