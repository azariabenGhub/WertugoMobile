<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/landing_pag"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Gambar dengan contentDescription -->
    <ImageView
        android:id="@+id/iv_landing"
        android:layout_width="match_parent"
        android:layout_height="610dp"
        android:layout_alignParentTop="true"
        android:scaleType="centerCrop"
        android:src="@drawable/landing_page"
        android:contentDescription="@string/content_desc_landing" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/iv_landing"
        android:layout_marginTop="32dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:fontFamily="sans-serif" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_subtitle"
            android:textSize="16sp"
            android:textColor="#666666"
            android:gravity="center" />

        <!-- Tombol Daftar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_daftar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:text="@string/button_daftar"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#008B09"
            app:cornerRadius="28dp"
            android:fontFamily="sans-serif-medium" />

        <!-- Login Link dengan area sentuh minimal 48dp dan rasio kontras yang cukup -->
        <TextView
            android:id="@+id/tv_login_link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/text_login_link"
            android:textSize="14sp"
            android:textColor="#000000"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="1dp"
            android:paddingBottom="12dp"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:background="?attr/selectableItemBackgroundBorderless" />

    </LinearLayout>

</RelativeLayout>