<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="100dp"> <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_detail_place_image"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:background="#E0E0E0"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_detail_place_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cafe Penalama Surya Kencana"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_mylocation" app:tint="@color/black" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_detail_place_address" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ini Alamat Tempatnya" android:textColor="#555555" android:textSize="14sp" android:layout_marginStart="12dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_info_details" app:tint="@color/black" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_detail_place_desc" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ini Deskripsi Pribadi tentang tempat, bisa buat menaruh link sosmed, detail lokasi, dan sebagainya" android:textColor="#555555" android:textSize="14sp" android:layout_marginStart="12dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="12dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_edit" app:tint="@color/black" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_detail_place_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Culinary" android:textColor="#555555" android:textSize="14sp" android:layout_marginStart="12dp"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
                <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@android:drawable/ic_menu_myplaces" app:tint="@color/black" android:layout_marginTop="2dp"/>
                <TextView android:id="@+id/tv_detail_place_added_by" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Ditambahkan oleh Prima Yudhistira" android:textColor="#555555" android:textSize="14sp" android:layout_marginStart="12dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_overall_rating"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="24dp">

                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/star_on" app:tint="@color/black" />

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="12dp">
                    <TextView android:id="@+id/tv_overall_rating_score" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="4,7/5" android:textColor="@color/black" android:textSize="16sp" android:textStyle="bold"/>
                    <TextView android:id="@+id/tv_overall_rating_count" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dirating oleh 4 dari 5 anggota" android:textColor="#888888" android:textSize="12sp"/>
                </LinearLayout>

                <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@android:drawable/ic_media_play" app:tint="@color/black" /> </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginBottom="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_rate"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Rate"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="#C0392B"
                    app:cornerRadius="25dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_action_edit"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Edit"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    app:backgroundTint="#F39C12"
                    app:cornerRadius="25dp" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#E0E0E0" android:layout_marginBottom="16dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Komentar Anggota"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_member_comments"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:itemCount="2"
                tools:listitem="@layout/item_member_comment" />

        </LinearLayout>
    </LinearLayout>
    </ScrollView>

    <include
        android:id="@+id/layout_user_navbar"
        layout="@layout/layout_bottom_nav_traveller"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>