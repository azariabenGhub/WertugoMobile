<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".BucketListMainActivity">

    <!-- TOP AREA: SEARCH BAR -->
    <RelativeLayout
        android:id="@+id/layout_search_bucket_header"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:paddingHorizontal="24dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="48dp"
            app:cardCornerRadius="10dp"
            app:cardBackgroundColor="@color/white"
            app:cardElevation="0dp"
            app:strokeColor="#008B09"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="@color/black" />

                <EditText
                    android:id="@+id/et_search_bucket"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:background="@android:color/transparent"
                    android:hint="Cari Bucket List Saya..."
                    android:textColor="@color/black"
                    android:textColorHint="#888888"
                    android:textSize="14sp"
                    android:inputType="text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </RelativeLayout>

    <!-- CENTER AREA STATE A: EMPTY STATE CONTAINER -->
    <LinearLayout
        android:id="@+id/layout_empty_bucket"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="40dp"
        app:layout_constraintTop_toBottomOf="@id/layout_search_bucket_header"
        app:layout_constraintBottom_toTopOf="@id/layout_user_navbar">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Anda belum memiliki bucket list"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Buat bucket list atau ikut\nke dalam bucket list teman"
            android:textColor="#555555"
            android:textSize="15sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.2" />
    </LinearLayout>

    <!-- CENTER AREA STATE B: RECYCLERVIEW UNTUK CARD KAMAR BIRU -->
    <!-- Bawaan awal diset 'gone', otomatis visible jika data bucket list ada -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_bucket_rooms"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="24dp"
        android:visibility="gone"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/layout_search_bucket_header"
        app:layout_constraintBottom_toTopOf="@id/layout_user_navbar"
        tools:listitem="@layout/item_bucket_list" />

    <!-- FLOATING ACTION BUTTON (FAB '+' Hijau) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/fab_create_bucket"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="14dp"
        app:cardBackgroundColor="#52D681"
        app:cardElevation="4dp"
        app:strokeColor="@color/black"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/layout_user_navbar"
        app:layout_constraintEnd_toEndOf="parent">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="@color/black"
            android:layout_gravity="center"
            tools:ignore="ContentDescription" />
    </com.google.android.material.card.MaterialCardView>

    <!-- BOTTOM NAVBAR USER (Active di Menu ke-3 Bucket List) -->
    <LinearLayout
        android:id="@+id/layout_user_navbar"
        android:layout_width="match_parent"
        android:layout_height="90dp"
        android:background="#008B09"
        android:orientation="horizontal"
        android:weightSum="4"
        android:gravity="center"
        android:paddingHorizontal="16dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:id="@+id/nav_home" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_home" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:id="@+id/nav_search" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_search" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:background="@drawable/bg_nav_active" android:gravity="center" android:layout_marginEnd="16dp">
            <ImageView android:id="@+id/nav_message" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_message" app:tint="#FFFFFF" />
        </LinearLayout>
        <LinearLayout android:layout_width="75dp" android:layout_height="75dp" android:gravity="center">
            <ImageView android:id="@+id/nav_profile" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_profile" app:tint="#FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <!-- BLACK DIMMING OVERLAY BACKGROUND -->
    <!-- Dipanggil Java untuk membuat layar belakang gelap pekat saat popup muncul -->
    <View
        android:id="@+id/view_dim_overlay_bucket"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>
