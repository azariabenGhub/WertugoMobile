<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#3CA0E1"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Kiri: Informasi Tempat Wisata -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/layout_right_utility">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cafe Penalama Surya Kencana"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Cafe Penalama Surya Kencana"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bogor, Jawa Barat"
                android:textColor="#E0F2E9"
                android:textSize="11sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category: Food"
                android:textColor="#E0F2E9"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Kanan: Utility (Rating + Star + Trash Icon) -->
        <LinearLayout
            android:id="@+id/layout_right_utility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Nilai Rating -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4,6/5"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                tools:text="4,6/5"/>

            <!-- Ikon Bintang -->
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@android:drawable/btn_star_big_on"
                app:tint="@color/black"
                tools:ignore="ContentDescription" />

            <!-- Ikon Hapus Item Tempat (Far Right) -->
            <ImageView
                android:id="@+id/btn_delete_place_item"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="14dp"
                android:src="@android:drawable/ic_menu_delete"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#111111"
                tools:ignore="ContentDescription" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>