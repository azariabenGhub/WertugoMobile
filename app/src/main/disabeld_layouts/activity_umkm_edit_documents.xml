<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".UmkmEditDocumentsActivity">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_buttons_action">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Edit Dokumen\nVerifikasi Usaha"
                android:textColor="@color/black"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="32dp" />

            <TextView android:text="Nomor Induk Berusaha (NIB)" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_upload_nib"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#008B09"
                app:cardElevation="0dp"
                app:strokeColor="#008B09"
                app:strokeWidth="1dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <TextView android:id="@+id/tv_nib_filename" android:text="nib.jpg" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload" app:tint="#FFFFFF" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:text="Scan Nomor Induk Berusaha" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="24dp"/>

            <TextView android:text="Nomor Pokok Wajib Pajak (NPWP)" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_upload_npwp"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#008B09"
                app:cardElevation="0dp"
                app:strokeColor="#008B09"
                app:strokeWidth="1dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <TextView android:id="@+id/tv_npwp_filename" android:text="npwp.jpg" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload" app:tint="#FFFFFF" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:text="Scan Nomor Pokok Wajib Pajak (NPWP)" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="24dp"/>

            <TextView android:text="Dokumen Legalitas Bangunan" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_upload_legalitas"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="0dp"
                app:strokeColor="#008B09"
                app:strokeWidth="1dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <TextView android:id="@+id/tv_legalitas_filename" android:text="Upload File (JPG atau PNG)" android:textColor="#888888" android:textSize="14sp" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload" app:tint="#008B09" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:text="Scan Dokumen Legalitas Bangunan (Abaikan jika belum ada)" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="24dp"/>

            <TextView android:text="Sertifikat Halal" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_upload_halal"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="#008B09"
                app:cardElevation="0dp"
                app:strokeColor="#008B09"
                app:strokeWidth="1dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <TextView android:id="@+id/tv_halal_filename" android:text="sertifikathalal.jpg" android:textColor="#FFFFFF" android:textStyle="bold" android:textSize="14sp" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload" app:tint="#FFFFFF" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:text="Scan Sertifikat Halal (Abaikan jika belum atau tidak ada)" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="24dp"/>

            <TextView android:text="Sertifikat Usaha Pariwisata" android:textColor="@color/black" android:textSize="12sp" android:textStyle="bold" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_upload_pariwisata"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:cardCornerRadius="22dp"
                app:cardBackgroundColor="@color/white"
                app:cardElevation="0dp"
                app:strokeColor="#008B09"
                app:strokeWidth="1dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent" android:paddingHorizontal="20dp">
                    <TextView android:id="@+id/tv_pariwisata_filename" android:text="Upload File (JPG atau PNG)" android:textColor="#888888" android:textSize="14sp" android:layout_centerVertical="true" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
                    <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_upload" app:tint="#008B09" android:layout_alignParentEnd="true" android:layout_centerVertical="true"/>
                </RelativeLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:text="Scan Sertifikat Usaha Pariwisata (Abaikan jika belum ada)" android:textColor="#888888" android:textSize="11sp" android:layout_marginTop="4dp" android:layout_marginBottom="16dp"/>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/layout_buttons_action"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:weightSum="2"
        android:background="#F8F9FA"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_view">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_docs_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Kembali"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#888888"
            app:cornerRadius="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_edit_docs_confirm"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Konfirmasi"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#008B09"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <include
        android:id="@+id/bottom_nav_view"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>