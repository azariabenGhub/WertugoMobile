<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    app:cardCornerRadius="24dp"
    app:cardBackgroundColor="@color/white"
    app:cardElevation="8dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="24dp">

        <!-- Tombol Close Silang Merah (X) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/btn_close_verify_dialog"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="#FF3B30"
            android:padding="6dp"
            android:clickable="true"
            android:focusable="true"
            app:tint="@color/white"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.LargeComponent" />

        <!-- Judul Pop-up -->
        <TextView
            android:id="@+id/tv_verify_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/btn_close_verify_dialog"
            android:layout_marginTop="16dp"
            android:text="Verifikasi Diri Anda"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center" />

        <!-- Deskripsi Ringkas -->
        <TextView
            android:id="@+id/tv_verify_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_verify_title"
            android:layout_marginTop="6dp"
            android:text="Verifikasi dengan Password apakah ini benar-benar Anda."
            android:textColor="#555555"
            android:textSize="11sp"
            android:gravity="center" />

        <!-- Label Kolom Input -->
        <TextView
            android:id="@+id/tv_lbl_verify_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_verify_desc"
            android:layout_marginTop="24dp"
            android:text="Masukkan Password Anda"
            android:textColor="@color/black"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Kotak Teks Input Password (Outlined Biru) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/input_wrapper_verify_password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/tv_lbl_verify_password"
            android:layout_marginTop="8dp"
            app:boxCornerRadiusTopStart="10dp" app:boxCornerRadiusTopEnd="10dp"
            app:boxCornerRadiusBottomStart="10dp" app:boxCornerRadiusBottomEnd="10dp"
            app:boxStrokeColor="#3CA0E1" app:hintEnabled="false"
            app:passwordToggleEnabled="true" app:passwordToggleTint="#888888">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_verify_password"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:paddingVertical="8dp"
                android:hint="• • • • • • • •"
                android:textColorHint="#888888"
                android:textColor="@color/black"
                android:textSize="14sp"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Tombol Kirim / Aksi Utama -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_verify"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_below="@id/input_wrapper_verify_password"
            android:layout_marginTop="24dp"
            android:text="Verifikasi"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#008B09"
            app:cornerRadius="23dp" />

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>