<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="10dp"
    app:cardBackgroundColor="#E75E4D"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="16dp">

        <!-- Foto Profil Avatar Bundar Bulat -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_avatar_member"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_profile"
            android:background="#111111"
            android:padding="6dp"
            app:tint="@color/white"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.MaterialComponents.LargeComponent" />

        <!-- Detail Teks Identitas Anggota -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/iv_avatar_member"
            android:layout_toStartOf="@+id/btn_delete_member"
            android:layout_centerVertical="true"
            android:layout_marginStart="14dp">

            <TextView
                android:id="@+id/tv_member_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bani"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="14sp"
                tools:text="Bani" />

            <TextView
                android:id="@+id/tv_member_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Anggota"
                android:textColor="#F5D0CC"
                android:textSize="11sp"
                android:layout_marginTop="2dp"
                tools:text="Anggota" />
        </LinearLayout>

        <!-- Ikon Sampah Kick Anggota (Pojok Kanan Keras) -->
        <ImageView
            android:id="@+id/btn_delete_member"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:src="@android:drawable/ic_menu_delete"
            app:tint="#111111"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"/>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>