<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    tools:context=".UmkmOperationalActivity">

    <!-- KONTEN UTAMA -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/layout_buttons">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="32dp"
            android:paddingVertical="40dp">

            <!-- JUDUL HALAMAN -->
            <TextView
                android:id="@+id/tv_title_operational"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Jam Operasional"
                android:textColor="@color/black"
                android:textSize="34sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-black"
                android:layout_marginBottom="32dp" />

            <!-- CARD BLOK INFORMASI -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Jam Buka -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jam Buka"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_jam_buka_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="10.00 WIB"
                        android:textColor="#555555"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Divider Garis Tipis -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="20dp" />

                    <!-- Jam Tutup -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jam Tutup"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_jam_tutup_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="20.00 WIB"
                        android:textColor="#555555"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp"
                        android:layout_marginBottom="20dp" />

                    <!-- Divider Garis Tipis -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="20dp" />

                    <!-- Hari Buka -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hari Buka"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_hari_buka_val"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Setiap Hari"
                        android:textColor="#555555"
                        android:textSize="16sp"
                        android:layout_marginTop="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

    <!-- CONTAINER TOMBOL ACTION (Nangkring di atas Navbar) -->
    <LinearLayout
        android:id="@+id/layout_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="32dp"
        android:paddingVertical="16dp"
        android:weightSum="2"
        android:background="#F8F9FA"
        app:layout_constraintBottom_toTopOf="@id/bottom_nav_view">

        <!-- Tombol Kembali (Abu-abu) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_operational_back"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Kembali"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#9E9E9E"
            app:cornerRadius="24dp" />

        <!-- Tombol Edit (Oranye) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_operational_edit"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Edit"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:backgroundTint="#FF9100"
            app:cornerRadius="24dp" />
    </LinearLayout>

    <!-- FIXED BOTTOM NAVIGATION BAR -->
    <include
        android:id="@+id/bottom_nav_view"
        layout="@layout/layout_bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>